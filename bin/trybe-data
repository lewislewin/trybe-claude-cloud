#!/usr/bin/env python3
"""Call the investigation MCP server (masked, read-only production data) over plain HTTP.

Cloud sessions don't load MCP servers registered in ~/.claude.json, so this calls the
server's tools directly. The token comes from the environment's Network secret for
api.try.be (the proxy adds it), or from TRYBE_DATA_MCP_TOKEN when set.

  trybe-data tools                          list the tools and their input schemas
  trybe-data describe                       describe_resources: what can be queried
  trybe-data list <resource> ['<json>']     list_records; JSON holds filter/sort/limit/offset/with_trashed
  trybe-data show <resource> <id>           show_record
  trybe-data call <tool> ['<json args>']    any tool by name
"""
import json
import os
import sys
import urllib.error
import urllib.request

URL = os.environ.get("TRYBE_DATA_MCP_URL") or "https://api.try.be/shop/mcp/investigations"


def rpc(method, params=None):
    body = {"jsonrpc": "2.0", "id": 1, "method": method}
    if params is not None:
        body["params"] = params
    headers = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream"}
    token = os.environ.get("TRYBE_DATA_MCP_TOKEN")
    if token:
        headers["Authorization"] = "Bearer " + token
    req = urllib.request.Request(URL, data=json.dumps(body).encode(), headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            raw = resp.read().decode()
    except urllib.error.HTTPError as e:
        sys.exit(f"trybe-data: HTTP {e.code} from {URL}: {e.read().decode()[:500]}")
    if raw.lstrip().startswith(("event:", "data:")):
        raw = next(l[5:] for l in raw.splitlines() if l.startswith("data:"))
    data = json.loads(raw)
    if "error" in data:
        sys.exit(f"trybe-data: {json.dumps(data['error'])}")
    return data["result"]


def call(tool, args):
    result = rpc("tools/call", {"name": tool, "arguments": args})
    text = "\n".join(c.get("text", "") for c in result.get("content", []) if c.get("type") == "text")
    try:
        text = json.dumps(json.loads(text), indent=2)
    except ValueError:
        pass
    if result.get("isError"):
        sys.exit(f"trybe-data: tool error: {text}")
    print(text)


def json_arg(i):
    if len(sys.argv) <= i:
        return {}
    try:
        value = json.loads(sys.argv[i])
    except ValueError as e:
        sys.exit(f"trybe-data: argument {i} is not JSON: {e}")
    if not isinstance(value, dict):
        sys.exit("trybe-data: the JSON argument must be an object")
    return value


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "tools":
        print(json.dumps(rpc("tools/list")["tools"], indent=2))
    elif cmd == "describe":
        call("describe_resources", {})
    elif cmd == "list" and len(sys.argv) >= 3:
        call("list_records", {"resource": sys.argv[2], **json_arg(3)})
    elif cmd == "show" and len(sys.argv) == 4:
        call("show_record", {"resource": sys.argv[2], "id": sys.argv[3]})
    elif cmd == "call" and len(sys.argv) >= 3:
        call(sys.argv[2], json_arg(3))
    else:
        sys.exit(__doc__)


main()
